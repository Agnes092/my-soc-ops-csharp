@using SocOps.Models

<div class="flex flex-col min-h-full bg-background">
    <!-- Header -->
    <header class="bg-card border-b border-border px-4 py-3 shadow-sm">
        <button class="text-muted-foreground hover:text-foreground transition-colors focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-md px-2 py-1" @onclick="OnReset" aria-label="Go back">
            ← Back
        </button>
    </header>

    <!-- Instructions -->
    <p class="text-center text-muted-foreground text-sm py-2 px-4">
        Tap a square when you find someone who matches it.
    </p>

    <!-- Bingo indicator -->
    @if (HasBingo)
    {
        <div class="bg-accent text-accent-foreground text-center py-2 font-semibold text-sm">
            🎉 BINGO! You got a line!
        </div>
    }

    <!-- Board -->
    <div class="flex-1 flex items-center justify-center p-3">
        <BingoBoard
            Board="@Board"
            WinningSquareIds="@WinningSquareIds"
            OnSquareClick="@OnSquareClick" />
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
