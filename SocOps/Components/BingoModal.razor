@if (Show)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-background/80 backdrop-blur-sm">
        <div class="bg-card border border-border rounded-lg p-6 shadow-lg max-w-sm mx-auto text-center">
            <div class="text-4xl mb-4">🎉</div>
            <h2 class="text-2xl font-bold text-card-foreground mb-2">BINGO!</h2>
            <p class="text-muted-foreground mb-6">You completed a line!</p>

            <button class="bg-primary text-primary-foreground px-4 py-2 rounded-md font-medium hover:bg-primary/90 transition-colors focus:ring-2 focus:ring-ring focus:ring-offset-2" @onclick="OnDismiss">Keep Playing</button>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Show { get; set; }

    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
